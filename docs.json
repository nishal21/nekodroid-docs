{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "NekoDroid",
  "colors": {
    "primary": "#E8EAED",
    "light": "#E8EAED",
    "dark": "#111113"
  },
  "favicon": "/logo/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "installation",
              "how-it-works"
            ]
          },
          {
            "group": "ARM emulation",
            "pages": [
              "guides/web-interface",
              "guides/cpu-debugger",
              "guides/bare-metal-programs",
              "guides/boot-linux"
            ]
          },
          {
            "group": "APK runtime",
            "pages": [
              "android/run-apk",
              "android/supported-apks",
              "android/build-test-apk",
              "faq"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "icon": "library",
        "groups": [
          {
            "group": "Hardware",
            "pages": [
              "reference/memory-map",
              "reference/peripherals"
            ]
          },
          {
            "group": "Runtime",
            "pages": [
              "reference/dalvik-opcodes",
              "reference/demo-programs"
            ]
          }
        ]
      },
      {
        "tab": "API",
        "icon": "braces",
        "groups": [
          {
            "group": "JavaScript API",
            "pages": [
              "reference/wasm-api"
            ]
          }
        ]
      },
      {
        "tab": "Contributing",
        "icon": "git-pull-request",
        "groups": [
          {
            "group": "Contributing",
            "pages": [
              "contributing",
              "development"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/nishal21/NekoDroid",
        "icon": "github"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/nishal21/NekoDroid"
    }
  },
  "description": "Run ARM programs and small Android APKs in the browser. Rust to WebAssembly, local execution, no cloud runtime.",
  "background": {
    "color": {
      "light": "#FAFAFA",
      "dark": "#09090B"
    },
    "decoration": "grid"
  },
  "seo": {
    "metatags": {
      "og:site_name": "NekoDroid",
      "og:locale": "en_US",
      "author": "nishal21",
      "theme-color": "#09090B",
      "keywords": "NekoDroid, ARM emulator, Rust, WebAssembly, Dalvik HLE"
    },
    "indexing": "navigable"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "fonts": {
    "body": {
      "family": "IBM Plex Sans"
    },
    "heading": {
      "family": "Space Grotesk",
      "weight": 600
    }
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "icons": {
    "library": "fontawesome"
  }
}
