            ]
          },
          {
            "group": "Explore & Build",
            "icon": "microchip",
            "pages": [
              "guides/web-interface",
              "guides/cpu-debugger",
              "guides/bare-metal-programs",
              "guides/boot-linux"
            ]
          },
          {
            "group": "Android HLE",
            "icon": "mobile-screen",
            "pages": [
              "android/run-apk",
              "android/supported-apks",
              "android/build-test-apk"
            ]
          },
          {
            "group": "Project & Help",
            "icon": "circle-question",
            "pages": [
              "faq",
              "contributing"
            ]
          },
          {
            "group": "Images",
            "pages": [
              "images/build-pipeline.svg",
              "images/nekodroid-execution-paths.svg"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "icon": "code",
        "groups": [
          {
            "group": "Machine Reference",
            "icon": "memory",
            "pages": [
              "reference/memory-map",
              "reference/peripherals",
              "reference/dalvik-opcodes"
            ]
          },
          {
            "group": "API & Examples",
            "icon": "terminal",
            "pages": [
              "reference/wasm-api",
              "reference/demo-programs"
            ]
          }
        ]
      }
    ]
  },
