{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "NekoDroid",
  "colors": {
    "primary": "#7c83ff",
    "light": "#9aa0ff",
    "dark": "#5b61d6"
  },
  "favicon": "/logo/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "installation",
              "how-it-works"
            ]
          },
          {
            "group": "ARM emulation",
            "pages": [
              "guides/web-interface",
              "guides/cpu-debugger",
              "guides/bare-metal-programs",
              "guides/boot-linux"
            ]
          },
          {
            "group": "APK runtime",
            "pages": [
              "android/run-apk",
              "android/supported-apks",
              "android/build-test-apk",
              "faq"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "icon": "library",
        "groups": [
          {
            "group": "Hardware",
            "pages": [
              "reference/memory-map",
              "reference/peripherals"
            ]
          },
          {
            "group": "Runtime",
            "pages": [
              "reference/dalvik-opcodes",
              "reference/demo-programs"
            ]
          }
        ]
      },
      {
        "tab": "API",
        "icon": "braces",
        "groups": [
          {
            "group": "JavaScript API",
            "pages": [
              "reference/wasm-api"
            ]
          }
        ]
      },
      {
        "tab": "Contributing",
        "icon": "git-pull-request",
        "groups": [
          {
            "group": "Contributing",
            "pages": [
              "contributing",
              "development"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/nishal21/NekoDroid",
        "icon": "github"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/nishal21/NekoDroid"
    }
  },
  "description": "Documentation for NekoDroid, a Rust and WebAssembly ARM emulator with a separate, constrained Dalvik HLE runtime for small APK fixtures.",
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#0c0c0d"
    }
  },
  "seo": {
    "metatags": {
      "og:site_name": "NekoDroid",
      "og:locale": "en_US",
      "author": "nishal21",
      "theme-color": "#0c0c0d"
    },
    "indexing": "navigable"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "fonts": {
    "body": {
      "family": "Inter"
    },
    "heading": {
      "family": "Inter",
      "weight": 600
    }
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "icons": {
    "library": "lucide"
  }
}