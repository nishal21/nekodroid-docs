    "color": {
      "light": "#FAF9FE",
      "dark": "#0E0C18"
    }
  },
  "seo": {
    "metatags": {
      "og:site_name": "NekoDroid",
      "og:locale": "en_US",
      "author": "nishal21",
      "theme-color": "#7C3AED",
      "keywords": "NekoDroid, ARM emulator, Rust, WebAssembly, Dalvik HLE, APK browser emulator"
    },
    "indexing": "navigable"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "fonts": {
    "family": "Inter"
  }
